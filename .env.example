# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

PORT=5000

# Local MongoDB (default install) or paste a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/movie-review-app

# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# URL where the React app runs (used for CORS)
CLIENT_URL=http://localhost:5173
